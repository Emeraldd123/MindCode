#!/usr/bin/env bash
# tools/smoke: End-to-end smoke test script for MindCode in fake mode (MINDCODE_FAKE_LLM=1)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export MINDCODE_FAKE_LLM=1

cd "$ROOT"
node --input-type=module <<'NODE_SCRIPT'
import { createServer } from "vite";

const vite = await createServer({
  server: { middlewareMode: true },
  appType: "custom",
});

try {
  const { ai } = await vite.ssrLoadModule("./api/ai.ts");
  const { handle, runBuild } = await vite.ssrLoadModule("./api/router.ts");
  const { memoryStorage } = await vite.ssrLoadModule("./api/storage.ts");

  const storage = memoryStorage();
  let idCounter = 0;
  const deps = {
    storage,
    ai,
    startBuild: (sid, bid) => runBuild({ storage, ai }, sid, bid),
    newId: () => `s${++idCounter}`,
  };

  async function req(method, path, body) {
    const r = new Request(`http://localhost:8888/api${path}`, {
      method,
      headers: body !== undefined ? { "content-type": "application/json" } : undefined,
      body: body !== undefined ? JSON.stringify(body) : undefined,
    });
    const res = await handle(r, deps);
    const ct = res.headers.get("content-type") ?? "";
    const data = ct.includes("json") ? await res.json() : await res.text();
    return { status: res.status, headers: res.headers, body: data };
  }

  function fail(msg) {
    console.error(`\n[smoke] ERROR: ${msg}`);
    process.exit(1);
  }

  // 1. Health check
  process.stdout.write("[smoke] 1. Health check... ");
  const health = await req("GET", "/health");
  if (health.status !== 200 || !health.body?.ok) {
    fail(`Health check failed (status: ${health.status})`);
  }
  console.log("OK");

  // 2. Create session
  process.stdout.write("[smoke] 2. Create session... ");
  const sessionRes = await req("POST", "/sessions");
  const sid = sessionRes.body?.id;
  if (sessionRes.status !== 200 || !sid || !Array.isArray(sessionRes.body?.map?.nodes)) {
    fail("Failed to create session");
  }
  console.log(`OK (sid: ${sid})`);

  // 3. Chat turn 1 (extract map & async turn conflict)
  process.stdout.write("[smoke] 3. Chat turn 1 (extract map & async turn conflict)... ");
  const msgRes = await req("POST", `/sessions/${sid}/messages`, {
    text: "I want a chat app for my study group",
  });
  const nodes = msgRes.body?.map?.nodes;
  if (msgRes.status !== 200 || !Array.isArray(nodes) || nodes.length < 5) {
    fail("Prompt extraction did not return at least 5 nodes");
  }
  const userNodes = nodes.filter((n) => n.source === "user");
  if (userNodes.length === 0 || !userNodes.some((n) => Array.isArray(n.evidence) && n.evidence.length > 0)) {
    fail("Missing user source node with non-empty evidence");
  }
  const inferredNodes = nodes.filter((n) => n.source === "inferred");
  if (
    inferredNodes.length === 0 ||
    !inferredNodes.some((n) => typeof n.inventiveness === "number" && n.inventiveness >= 0 && n.inventiveness <= 1)
  ) {
    fail("Missing inferred source node with inventiveness between 0 and 1");
  }
  const unknownNode = nodes.find((n) => n.source === "unknown");
  if (!unknownNode) {
    fail("Missing unknown source node");
  }

  // Simulate pending turn in storage; second POST must return 409
  const sBeforePending = await storage.get(sid);
  sBeforePending.turn = { status: "pending", changed: [], started_at: Date.now() };
  await storage.put(sBeforePending);

  const pendingRes = await req("POST", `/sessions/${sid}/messages`, {
    text: "Another message while previous turn is still running",
  });
  if (pendingRes.status !== 409) {
    fail(`Second POST /messages while turn pending returned status ${pendingRes.status}, expected 409`);
  }

  sBeforePending.turn = { status: "done", changed: [], started_at: sBeforePending.turn.started_at };
  await storage.put(sBeforePending);
  console.log(`OK (${nodes.length} nodes, 409 on pending turn)`);

  // 4. Bubble chat
  process.stdout.write("[smoke] 4. Bubble chat... ");
  const chatRes = await req("POST", `/sessions/${sid}/nodes/${unknownNode.id}/chat`, {
    text: "just a nickname, no passwords",
  });
  const updatedNode = chatRes.body?.node;
  if (chatRes.status !== 200 || updatedNode?.label !== "Nickname login") {
    fail(`Bubble chat failed to rewrite label to Nickname login (got "${updatedNode?.label}")`);
  }
  console.log(`OK (rewritten to ${updatedNode.label})`);

  // 5. Approve bubble
  process.stdout.write("[smoke] 5. Approve bubble... ");
  const approveRes = await req("POST", `/sessions/${sid}/nodes/${unknownNode.id}/approve`);
  if (approveRes.status !== 200 || approveRes.body?.status !== "approved") {
    fail("Failed to approve bubble");
  }
  console.log("OK");

  // 6. Bubble ops (create node, create edge, delete edge, delete node & re-parenting)
  process.stdout.write("[smoke] 6. Bubble ops (create/delete node & edge, re-parenting)... ");
  const parentNodeRes = await req("POST", `/sessions/${sid}/nodes`, {
    label: "Parent Feature",
    parent: "n1",
  });
  const parentNode = parentNodeRes.body;
  if (parentNodeRes.status !== 201 || !parentNode?.id || parentNode?.parent !== "n1") {
    fail("Failed to create parent node");
  }

  const childNodeRes = await req("POST", `/sessions/${sid}/nodes`, {
    label: "Child Subfeature",
    parent: parentNode.id,
  });
  const childNode = childNodeRes.body;
  if (childNodeRes.status !== 201 || !childNode?.id || childNode?.parent !== parentNode.id) {
    fail("Failed to create child node");
  }

  const createEdgeRes = await req("POST", `/sessions/${sid}/edges`, {
    from: "n1",
    to: childNode.id,
    relation: "informs",
  });
  if (createEdgeRes.status !== 201 || createEdgeRes.body?.from !== "n1" || createEdgeRes.body?.to !== childNode.id) {
    fail("Failed to create edge");
  }

  const deleteEdgeRes = await req("DELETE", `/sessions/${sid}/edges`, {
    from: "n1",
    to: childNode.id,
  });
  if (deleteEdgeRes.status !== 200) {
    fail("Failed to delete edge");
  }
  const postDelEdgeSession = (await req("GET", `/sessions/${sid}`)).body;
  if (postDelEdgeSession?.map?.edges?.some((e) => e.from === "n1" && e.to === childNode.id && e.relation === "informs")) {
    fail("Deleted edge still present in session map");
  }

  const deleteNodeRes = await req("DELETE", `/sessions/${sid}/nodes/${parentNode.id}`);
  if (deleteNodeRes.status !== 200) {
    fail("Failed to delete node");
  }
  const postDelNodeSession = (await req("GET", `/sessions/${sid}`)).body;
  if (postDelNodeSession?.map?.nodes?.some((n) => n.id === parentNode.id)) {
    fail("Deleted node still present in session map");
  }
  const reParentedChild = postDelNodeSession?.map?.nodes?.find((n) => n.id === childNode.id);
  if (!reParentedChild || reParentedChild.parent !== "n1") {
    fail(`Child node not re-parented to n1 (got: ${reParentedChild?.parent})`);
  }
  console.log("OK");

  // 7. Trigger build & poll
  process.stdout.write("[smoke] 7. Trigger build & poll... ");
  const buildRes = await req("POST", `/sessions/${sid}/build`);
  let build = buildRes.body;
  const bid = build?.id;
  if (![200, 202].includes(buildRes.status) || !bid) {
    fail("Failed to initiate build");
  }
  if (build.status === "pending") {
    let attempts = 0;
    while (build.status === "pending" && attempts < 10) {
      attempts++;
      const pollRes = await req("GET", `/sessions/${sid}/builds/${bid}`);
      if (pollRes.status !== 200) fail("Poll request failed");
      build = pollRes.body;
    }
  }
  if (build.status !== "done") {
    fail(`Build status is ${build.status}, expected done`);
  }
  console.log(`OK (bid: ${bid})`);

  // 8. Inspect preview HTML & traces
  process.stdout.write("[smoke] 8. Inspect preview HTML & traces... ");
  const previewRes = await req("GET", `/sessions/${sid}/builds/${bid}/preview`);
  const html = previewRes.body;
  if (previewRes.status !== 200 || typeof html !== "string") {
    fail("Failed to fetch preview HTML");
  }
  if (!/<script[\s\S]*?>[\s\S]*?mc-hover[\s\S]*?<\/script>/i.test(html)) {
    fail("Preview HTML does not contain trace bridge script");
  }
  const sRes = await req("GET", `/sessions/${sid}`);
  const mapNodes = sRes.body?.map?.nodes || [];
  const validIds = new Set(mapNodes.map((n) => n.id));

  const elMatches = [...html.matchAll(/data-mc-el=["']([^"']+)["']\s+data-mc=["']([^"']+)["']/g)];
  const elMatchesRev = [...html.matchAll(/data-mc=["']([^"']+)["']\s+data-mc-el=["']([^"']+)["']/g)];
  const all = [
    ...elMatches.map((m) => ({ el: m[1], mc: m[2] })),
    ...elMatchesRev.map((m) => ({ el: m[2], mc: m[1] })),
  ];
  if (all.length === 0) {
    fail("No traced elements found in HTML");
  }
  for (const match of all) {
    const ids = match.mc.split(/\s+/).filter(Boolean);
    for (const id of ids) {
      if (!validIds.has(id)) {
        fail(`Found data-mc referencing unknown node id: ${id}`);
      }
    }
  }
  if (!build.audit || build.audit.totalElements <= 0 || typeof build.audit.coveragePct !== "number") {
    fail("Build audit missing or invalid");
  }
  console.log("OK");

  // 9. Standalone download check
  process.stdout.write("[smoke] 9. Standalone download check... ");
  const dlRes = await req("GET", `/sessions/${sid}/builds/${bid}/download`);
  const dlHtml = dlRes.body;
  const dlDisp = dlRes.headers.get("content-disposition") ?? "";
  if (dlRes.status !== 200 || typeof dlHtml !== "string") {
    fail("Failed to download standalone build HTML");
  }
  if (!dlDisp.includes(`attachment; filename="mindcode-${bid}.html"`)) {
    fail(`Invalid content-disposition header: ${dlDisp}`);
  }
  if (/<script[\s\S]*?>[\s\S]*?mc-hover[\s\S]*?<\/script>/i.test(dlHtml)) {
    fail("Standalone download HTML should not contain trace script");
  }
  console.log("OK");

  // 10. Checkpoint history
  process.stdout.write("[smoke] 10. Checkpoint history... ");
  const cpRes = await req("GET", `/sessions/${sid}/checkpoints`);
  const checkpoints = cpRes.body;
  if (cpRes.status !== 200 || !Array.isArray(checkpoints) || checkpoints.length === 0) {
    fail("Failed to fetch checkpoints");
  }
  console.log(`OK (${checkpoints.length} checkpoints)`);

  // 11. Checkpoint restore
  process.stdout.write("[smoke] 11. Checkpoint restore... ");
  const c1 = checkpoints[0];
  const restoreRes = await req("POST", `/sessions/${sid}/checkpoints/${c1.id}/restore`);
  if (restoreRes.status !== 200) {
    fail(`Restore failed with status ${restoreRes.status}`);
  }
  if (JSON.stringify(restoreRes.body?.map) !== JSON.stringify(c1.map)) {
    fail("Restored map does not match checkpoint map");
  }
  const postRestoreCpRes = await req("GET", `/sessions/${sid}/checkpoints`);
  const postRestoreCps = postRestoreCpRes.body;
  if (!Array.isArray(postRestoreCps) || !postRestoreCps.some((c) => c.label.startsWith("Restored to "))) {
    fail("New restore checkpoint was not recorded");
  }
  console.log("OK");

  // 12. Mind map export (Mermaid & JSON)
  process.stdout.write("[smoke] 12. Mind map export (Mermaid & JSON)... ");
  // 12a. Mermaid export
  const mermaidRes = await req("GET", `/sessions/${sid}/map/export?format=mermaid`);
  if (mermaidRes.status !== 200) {
    fail(`Mermaid export status ${mermaidRes.status}, expected 200`);
  }
  const mermaidCt = mermaidRes.headers.get("content-type") ?? "";
  if (!mermaidCt.includes("text/vnd.mermaid")) {
    fail(`Mermaid export unexpected content-type: ${mermaidCt}`);
  }
  const mermaidBody = mermaidRes.body;
  if (typeof mermaidBody !== "string" || !mermaidBody.includes("flowchart TD")) {
    fail("Mermaid export missing flowchart TD");
  }
  if (!/:::(user|inferred|unknown|approved)/.test(mermaidBody)) {
    fail("Mermaid export missing node class styling");
  }
  if (!/-->\|(has|needs)\|/.test(mermaidBody)) {
    fail("Mermaid export missing edge relation");
  }
  if (
    !mermaidBody.includes("classDef user") ||
    !mermaidBody.includes("classDef inferred") ||
    !mermaidBody.includes("classDef unknown") ||
    !mermaidBody.includes("classDef approved")
  ) {
    fail("Mermaid export missing classDef styling definitions");
  }

  // 12b. JSON export
  const jsonRes = await req("GET", `/sessions/${sid}/map/export?format=json`);
  if (jsonRes.status !== 200) {
    fail(`JSON export status ${jsonRes.status}, expected 200`);
  }
  const jsonCt = jsonRes.headers.get("content-type") ?? "";
  if (!jsonCt.includes("application/json")) {
    fail(`JSON export unexpected content-type: ${jsonCt}`);
  }
  const jsonDisp = jsonRes.headers.get("content-disposition") ?? "";
  if (!jsonDisp.includes(`attachment; filename="mindcode-map-${sid}.json"`)) {
    fail(`JSON export invalid content-disposition: ${jsonDisp}`);
  }
  const jsonExport = jsonRes.body;
  if (jsonExport?.id !== sid) {
    fail(`JSON export id mismatch: got ${jsonExport?.id}, expected ${sid}`);
  }
  if (!jsonExport?.exportedAt || isNaN(Date.parse(jsonExport.exportedAt))) {
    fail("JSON export missing or invalid exportedAt timestamp");
  }
  const latestSessionRes = await req("GET", `/sessions/${sid}`);
  const expectedMap = latestSessionRes.body?.map;
  if (
    JSON.stringify(jsonExport?.nodes) !== JSON.stringify(expectedMap?.nodes) ||
    JSON.stringify(jsonExport?.edges) !== JSON.stringify(expectedMap?.edges)
  ) {
    fail("JSON export nodes/edges do not match session map");
  }

  // Default export (no format query)
  const defaultExportRes = await req("GET", `/sessions/${sid}/map/export`);
  if (defaultExportRes.status !== 200) {
    fail(`Default map export status ${defaultExportRes.status}, expected 200`);
  }
  const defaultDisp = defaultExportRes.headers.get("content-disposition") ?? "";
  if (!defaultDisp.includes(`attachment; filename="mindcode-map-${sid}.json"`)) {
    fail(`Default map export invalid content-disposition: ${defaultDisp}`);
  }

  // 12c. Invalid format validation
  const invalidRes = await req("GET", `/sessions/${sid}/map/export?format=invalid`);
  if (invalidRes.status !== 422) {
    fail(`Invalid format export returned status ${invalidRes.status}, expected 422`);
  }
  console.log("OK");

  // 13. Demo session
  process.stdout.write("[smoke] 13. Demo session... ");
  const demoRes = await req("POST", "/sessions/demo");
  const demoSession = demoRes.body;
  const demoSid = demoSession?.id;
  if (demoRes.status !== 200 || !demoSid || !Array.isArray(demoSession?.map?.nodes) || demoSession.map.nodes.length < 30) {
    fail(`Demo session failed or has fewer than 30 bubbles (${demoSession?.map?.nodes?.length})`);
  }
  const demoB1 = demoSession.builds?.find((b) => b.id === "b1");
  if (!demoB1 || demoB1.status !== "done") {
    fail("Demo session missing finished build b1");
  }
  const appRes = await req("GET", `/sessions/${demoSid}/builds/b1/app`);
  const appHtml = appRes.body;
  if (appRes.status !== 200 || typeof appHtml !== "string") {
    fail("Failed to fetch demo /builds/b1/app");
  }
  if (/<script[\s\S]*?>[\s\S]*?mc-hover[\s\S]*?<\/script>/i.test(appHtml) || appHtml.includes("mc-hover")) {
    fail("Demo app HTML should not contain mc-hover script");
  }
  console.log(`OK (sid: ${demoSid}, ${demoSession.map.nodes.length} bubbles)`);

  // 14. Edit build
  process.stdout.write("[smoke] 14. Edit build... ");
  const editRes = await req("POST", `/sessions/${demoSid}/builds/b1/edit`, {
    instruction: "Add dark mode toggle to header",
  });
  let b2 = editRes.body;
  if (![200, 202].includes(editRes.status) || !b2?.id) {
    fail("Failed to trigger edit build");
  }
  if (b2.status === "pending") {
    let attempts = 0;
    while (b2.status === "pending" && attempts < 10) {
      attempts++;
      const pollRes = await req("GET", `/sessions/${demoSid}/builds/${b2.id}`);
      if (pollRes.status !== 200) fail("Poll edit build failed");
      b2 = pollRes.body;
    }
  }
  if (b2.id !== "b2" || b2.mode !== "edit" || b2.status !== "done") {
    fail(`Edit build unexpected result: id=${b2?.id}, mode=${b2?.mode}, status=${b2?.status}`);
  }
  const editCpRes = await req("GET", `/sessions/${demoSid}/checkpoints`);
  const editCps = editCpRes.body;
  if (!Array.isArray(editCps) || editCps[editCps.length - 1]?.build_id !== "b2") {
    fail(`Checkpoint list does not end with build_id: b2 (got ${editCps?.[editCps?.length - 1]?.build_id})`);
  }
  console.log("OK (b2 mode: edit, done)");

  // 15. Incremental & full rebuilds
  process.stdout.write("[smoke] 15. Incremental & full rebuilds... ");
  const addNodeRes = await req("POST", `/sessions/${demoSid}/nodes`, {
    label: "Dark mode",
    parent: "n1",
  });
  if (addNodeRes.status !== 201 || addNodeRes.body?.label !== "Dark mode") {
    fail("Failed to add node for incremental rebuild");
  }
  const incBuildRes = await req("POST", `/sessions/${demoSid}/build`);
  let b3 = incBuildRes.body;
  if (![200, 202].includes(incBuildRes.status) || !b3?.id) {
    fail("Failed to trigger incremental build");
  }
  if (b3.status === "pending") {
    let attempts = 0;
    while (b3.status === "pending" && attempts < 10) {
      attempts++;
      const pollRes = await req("GET", `/sessions/${demoSid}/builds/${b3.id}`);
      if (pollRes.status !== 200) fail("Poll incremental build failed");
      b3 = pollRes.body;
    }
  }
  if (b3.mode !== "incremental" || b3.status !== "done") {
    fail(`Incremental build unexpected result: mode=${b3?.mode}, status=${b3?.status}`);
  }

  const fullBuildRes = await req("POST", `/sessions/${demoSid}/build`, { full: true });
  let b4 = fullBuildRes.body;
  if (![200, 202].includes(fullBuildRes.status) || !b4?.id) {
    fail("Failed to trigger full build");
  }
  if (b4.status === "pending") {
    let attempts = 0;
    while (b4.status === "pending" && attempts < 10) {
      attempts++;
      const pollRes = await req("GET", `/sessions/${demoSid}/builds/${b4.id}`);
      if (pollRes.status !== 200) fail("Poll full build failed");
      b4 = pollRes.body;
    }
  }
  if (b4.mode !== "full" || b4.status !== "done") {
    fail(`Full build unexpected result: mode=${b4?.mode}, status=${b4?.status}`);
  }
  console.log("OK (b3 incremental, b4 full)");

  console.log("[smoke] ALL CHECKS PASSED");
} finally {
  await vite.close();
}
NODE_SCRIPT
