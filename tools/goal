#!/usr/bin/env bash
# Post a GOAL to the board: the agents turn it into task issues and start the cycle (AGENTS.md section 6).
# Usage: BOARD_HUMAN=Ben tools/goal "build a web app that ..."      (or pipe the goal on stdin)
# Env: BOARD_HUMAN (your first name; defaults to your GitHub login)
set -u
cd "$(dirname "$0")/.." || exit 1
if [ $# -gt 0 ]; then goal="$*"; else goal="$(cat)"; fi
[ -n "$goal" ] || { echo "goal: usage: tools/goal \"what to build\"" >&2; exit 1; }
who="${BOARD_HUMAN:-$(tools/board whoami 2>/dev/null | head -n 1)}"
[ -n "$who" ] || { echo "goal: set BOARD_HUMAN or run gh auth login" >&2; exit 1; }
tools/board post "[${who}'s Human] @all GOAL: ${goal}

@agents: first free agent posts \"planning the GOAL\", writes docs/product.md + docs/api-contract.md and files task issues (AGENTS.md section 6). Then claim, build, review, merge."
