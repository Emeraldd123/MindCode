   "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Study Group Chat</title>\n<style>\n:root{--bg:#f4f6fb;--panel:#fff;--ink:#1d2333;--muted:#6b7385;--line:#e3e7ef;--brand:#4f5bd5;--brand2:#eef0ff;--mine:#4f5bd5;--ok:#22a06b;--danger:#d64545;--r:12px}\n*{box-sizing:border-box}\nbody{margin:0;font:15px/1.45 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:var(--bg);color:var(--ink);height:100vh;display:flex;flex-direction:column}\nbutton,input{font:inherit}\nbutton{cursor:pointer;border:0;border-radius:8px;padding:.5rem .8rem;background:var(--brand);color:#fff}\nbutton.ghost{background:transparent;color:var(--brand);border:1px solid var(--line)}\nbutton:hover{filter:brightness(1.05)}\n:focus-visible{outline:3px solid #9aa3ff;outline-offset:2px}\ninput[type=text]{width:100%;padding:.55rem .7rem;border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--ink)}\nheader{display:flex;align-items:center;gap:.75rem;padding:.7rem 1rem;background:var(--panel);border-bottom:1px solid var(--line)}\nheader h1{font-size:1.1rem;margin:0;flex:1}\n.me{font-size:.9rem;color:var(--muted)}\n.layout{flex:1;display:grid;grid-template-columns:220px 1fr 200px;min-height:0}\naside{background:var(--panel);border-right:1px solid var(--line);padding:1rem;overflow:auto}\naside.members{border-right:0;border-left:1px solid var(--line)}\naside h2{font-size:.78rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:0 0 .6rem}\n.glist{list-style:none;margin:0 0 1rem;padding:0;display:grid;gap:.25rem}\n.glist button{width:100%;text-align:left;background:transparent;color:var(--ink);padding:.5rem .6rem}\n.glist button.active{background:var(--brand2);color:var(--brand);font-weight:600}\n.note{font-size:.75rem;color:var(--muted);margin-top:.5rem;font-style:italic}\n.chat{display:flex;flex-direction:column;min-height:0;min-width:0}\n.chathead{display:flex;gap:.5rem;align-items:center;padding:.7rem 1rem;border-bottom:1px solid var(--line);background:var(--panel);flex-wrap:wrap}\n.chathead h2{margin:0;font-size:1rem;flex:1}\n.chathead input{max-width:180px}\n.msgs{flex:1;overflow:auto;padding:1rem;display:flex;flex-direction:column;gap:.6rem}\n.msg{max-width:75%;background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:.5rem .75rem;align-self:flex-start;word-wrap:break-word}\n.msg.mine{align-self:flex-end;background:var(--mine);color:#fff;border-color:var(--mine)}\n.meta{font-size:.75rem;opacity:.75;display:flex;gap:.5rem;align-items:center;margin-bottom:.15rem}\n.meta button{background:transparent;color:inherit;padding:0 .2rem;font-size:.75rem;text-decoration:underline}\n.msg img{max-width:100%;max-height:220px;border-radius:8px;display:block;margin-top:.3rem}\n.file{display:inline-block;margin-top:.3rem;padding:.35rem .55rem;border-radius:8px;background:rgba(0,0,0,.06);color:inherit}\n.empty{color:var(--muted);text-align:center;margin:auto}\n.composer{display:flex;gap:.5rem;padding:.7rem 1rem;border-top:1px solid var(--line);background:var(--panel);align-items:center;flex-wrap:wrap}\n.composer input[type=text]{flex:1;min-width:140px}\n.attach{font-size:.8rem;color:var(--muted);width:100%}\n.mlist{list-style:none;margin:0;padding:0;display:grid;gap:.4rem}\n.mlist li{display:flex;align-items:center;gap:.5rem}\n.dot{width:9px;height:9px;border-radius:50%;background:#c4c9d4}\n.dot.on{background:var(--ok)}\n.overlay{position:fixed;inset:0;background:rgba(20,24,40,.55);display:flex;align-items:center;justify-content:center;padding:1rem;z-index:5}\n.overlay[hidden]{display:none}\n.card{background:var(--panel);border-radius:16px;padding:1.5rem;width:100%;max-width:360px;display:grid;gap:.75rem}\n.card h2{margin:0}\n.err{color:var(--danger);font-size:.85rem;min-height:1em}\n.toast{position:fixed;bottom:1rem;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:.5rem .9rem;border-radius:8px;font-size:.85rem;opacity:0;transition:.2s;pointer-events:none}\n.toast.show{opacity:1}\n@media (max-width:820px){\n .layout{grid-template-columns:1fr;grid-template-rows:auto 1fr auto}\n aside{border-right:0;border-bottom:1px solid var(--line);padding:.7rem 1rem}\n .glist{display:flex;overflow:auto}\n .glist button{white-space:nowrap}\n aside.members{border-left:0;border-top:1px solid var(--line);max-height:120px}\n .mlist{display:flex;flex-wrap:wrap;gap:.75rem}\n .msg{max-width:90%}\n}\n</style>\n</head>\n<body>\n<header data-mc-el=\"e1\" data-mc=\"n1\">\n  <h1>📚 Study Group Chat</h1>\n  <span class=\"me\" id=\"meLabel\" data-mc-el=\"e2\" data-mc=\"n5\"></span>\n  <button class=\"ghost\" id=\"renameBtn\" data-mc-el=\"e3\" data-mc=\"n5\">Change nickname</button>\n</header>\n\n<div class=\"layout\" data-mc-el=\"e4\" data-mc=\"n6\">\n  <aside data-mc-el=\"e5\" data-mc=\"n8\">\n    <h2>Study groups</h2>\n    <ul class=\"glist\" id=\"groupList\" data-mc-el=\"e6\" data-mc=\"n8\"></ul>\n    <form id=\"groupForm\" data-mc-el=\"e7\" data-mc=\"n8\">\n      <input type=\"text\" id=\"groupName\" placeholder=\"New group name\" maxlength=\"40\" aria-label=\"New group name\">\n      <button type=\"submit\" style=\"margin-top:.4rem;width:100%\">+ Create group</button>\n    </form>\n    <p class=\"note\" data-mc-el=\"e8\" data-mc=\"n8\">Assumed: multiple study groups are supported, each with its own room link.</p>\n  </aside>\n\n  <main class=\"chat\" data-mc-el=\"e9\" data-mc=\"n2 n6\">\n    <div class=\"chathead\">\n      <h2 id=\"roomTitle\" data-mc-el=\"e10\" data-mc=\"n2\">Room</h2>\n      <input type=\"text\" id=\"search\" placeholder=\"Search messages\" aria-label=\"Search messages\" data-mc-el=\"e11\" data-mc=\"n4\">\n      <button class=\"ghost\" id=\"copyLink\" data-mc-el=\"e12\" data-mc=\"n5 n8\">🔗 Copy room link</button>\n    </div>\n    <div class=\"msgs\" id=\"msgs\" aria-live=\"polite\" data-mc-el=\"e13\" data-mc=\"n2 n3 n4\"></div>\n    <form class=\"composer\" id=\"composer\" data-mc-el=\"e14\" data-mc=\"n2 n6\">\n      <label class=\"ghost\" for=\"fileInput\" style=\"cursor:pointer;padding:.5rem .6rem;border:1px solid var(--line);border-radius:8px;color:var(--brand)\" data-mc-el=\"e15\" data-mc=\"n7\" title=\"Attach notes, PDF or image\">📎</label>\n      <input type=\"file\" id=\"fileInput\" accept=\"image/*,.pdf,.txt,.md,.doc,.docx\" hidden>\n      <input type=\"text\" id=\"msgInput\" placeholder=\"Write a message…\" maxlength=\"1000\" aria-label=\"Message\" autocomplete=\"off\">\n      <button type=\"submit\" data-mc-el=\"e16\" data-mc=\"n2 n3\">Send</button>\n      <div class=\"attach\" id=\"attachInfo\" data-mc-el=\"e17\" data-mc=\"n7\"></div>\n      <div class=\"note\" style=\"margin:0\" data-mc-el=\"e18\" data-mc=\"n7 n3\">Assumed: files up to 1 MB are stored in this browser; live updates sync across open tabs.</div>\n    </form>\n  </main>\n\n  <aside class=\"members\" data-mc-el=\"e19\" data-mc=\"n6 n5\">\n    <h2>Members <span id=\"memberCount\"></span></h2>\n    <ul class=\"mlist\" id=\"memberList\"></ul>\n  </aside>\n</div>\n\n<div class=\"overlay\" id=\"joinOverlay\" hidden data-mc-el=\"e20\" data-mc=\"n5\">\n  <form class=\"card\" id=\"joinForm\">\n    <h2>Join the study group</h2>\n    <p style=\"margin:0;color:var(--muted)\">Just pick a nickname — no account or password needed.</p>\n    <input type=\"text\" id=\"nickInput\" placeholder=\"Your nickname\" maxlength=\"24\" aria-label=\"Nickname\">\n    <div class=\"err\" id=\"joinErr\"></div>\n    <button type=\"submit\">Join chat</button>\n  </form>\n</div>\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\nconst mem = {}; const storage = { get(k){ try { return JSON.parse(localStorage.getItem(k)); } catch { return mem[k] ?? null; } }, set(k,v){ try { localStorage.setItem(k, JSON.stringify(v)); } catch { mem[k] = v; } } };\nconst $ = id => document.getElementById(id);\nconst uid = () => Math.random().toString(36).slice(2,10) + Date.now().toString(36).slice(-4);\nconst esc = s => String(s).replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst K = {g:'sgc.groups', m:'sgc.messages', mb:'sgc.members', me:'sgc.me'};\n\nlet bc = { postMessage(){} };\ntry { bc = new BroadcastChannel('study-group-chat'); } catch {}\n\nconst store = {\n  groups(){ return storage.get(K.g) || []; },\n  addGroup(name, remote){ const g = remote || {id: uid(), name, created: Date.now()}; const all = store.groups(); if(!all.some(x=>x.id===g.id)){ all.push(g); storage.set(K.g, all); } if(!remote) bc.postMessage({t:'group', g}); return g; },\n  messages(gid){ return (storage.get(K.m) || []).filter(m => m.groupId === gid).sort((a,b)=>a.ts-b.ts); },\n  addMessage(m, remote){ const all = storage.get(K.m) || []; if(!all.some(x=>x.id===m.id)){ all.push(m); storage.set(K.m, all); } if(!remote) bc.postMessage({t:'msg', m}); return m; },\n  deleteMessage(id, remote){ storage.set(K.m, (storage.get(K.m)||[]).filter(m=>m.id!==id)); if(!remote) bc.postMessage({t:'del', id}); },\n  members(gid){ return (storage.get(K.mb) || []).filter(x => x.groupId === gid); },\n  touchMember(rec, remote){ const all = (storage.get(K.mb) || []).filter(x => !(x.groupId===rec.groupId && x.deviceId===rec.deviceId)); all.push(rec); storage.set(K.mb, all); if(!remote) bc.postMessage({t:'member', rec}); }\n};\n\nfunction seed(){\n  if(store.groups().length) return;\n  const now = Date.now(), H = 3600e3;\n  const g1 = {id:'bio101', name:'Bio 101 Study Group', created: now-5*H}, g2 = {id:'calc2', name:'Calc II Crew', created: now-4*H};\n  storage.set(K.g, [g1, g2]);\n  const ppl = [['d-maya','Maya'],['d-leo','Leo'],['d-priya','Priya']];\n  storage.set(K.mb, [...ppl.map(([d,n])=>({groupId:'bio101', deviceId:d, name:n, lastSeen: now-2*H})), {groupId:'calc2', deviceId:'d-leo', name:'Leo', lastSeen: now-3*H}]);\n  const msg = (g,d,n,ts,c,file) => ({id:uid(), groupId:g, senderId:d, senderName:n, ts, content:c, file:file||null});\n  storage.set(K.m, [\n    msg('bio101','d-maya','Maya',now-3*H,'Hey all! Quiz on cell respiration is Friday 🧬'),\n    msg('bio101','d-leo','Leo',now-2.8*H,'Can we meet in the library Thursday at 6?'),\n    msg('bio101','d-priya','Priya',now-2.5*H,'Works for me. I\\'ll bring my Krebs cycle summary.'),\n    msg('bio101','d-maya','Maya',now-2*H,'Uploaded my notes here:', {name:'krebs-notes.txt', type:'text/plain', size:120, data:'data:text/plain;charset=utf-8,'+encodeURIComponent('Krebs cycle\\n- Acetyl-CoA + oxaloacetate -> citrate\\n- 3 NADH, 1 FADH2, 1 ATP per turn')}),\n    msg('calc2','d-leo','Leo',now-3*H,'Anyone solved problem 7 on integration by parts?')\n  ]);\n}\n\nlet me = storage.get(K.me);\nlet current = null;\nlet pendingFile = null;\n\nfunction toast(t){ const el=$('toast'); if(!el) return; el.textContent=t; el.classList.add('show'); clearTimeout(toast.t); toast.t=setTimeout(()=>el.classList.remove('show'),1800); }\nfunction fmtTime(ts){ const d=new Date(ts); const today=new Date().toDateString()===d.toDateString(); return (today?'':d.toLocaleDateString([], {month:'short', day:'numeric'})+' ')+d.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}); }\nfunction fmtSize(b){ return b>1024*1024 ? (b/1048576).toFixed(1)+' MB' : Math.max(1,Math.round(b/1024))+' KB'; }\n\nfunction groupFromHash(){ const m = location.hash.match(/g=([\\w-]+)/); return m ? m[1] : null; }\nfunction roomLink(gid){ return location.href.split('#')[0] + '#g=' + gid; }\n\nfunction selectGroup(gid){\n  const g = store.groups().find(x=>x.id===gid) || store.groups()[0];\n  if(!g) return;\n  current = g.id;\n  try { history.replaceState(null,'','#g='+g.id); } catch {}\n  if(me) store.touchMember({groupId:g.id, deviceId:me.deviceId, name:me.name, lastSeen:Date.now()});\n  renderAll();\n}\n\nfunction renderGroups(){\n  const ul=$('groupList'); if(!ul) return;\n  ul.innerHTML = store.groups().map(g=>`<li><button data-gid=\"${esc(g.id)}\" class=\"${g.id===current?'active':''}\"># ${esc(g.name)}</button></li>`).join('');\n}\n\nfunction renderMessages(){\n  const box=$('msgs'); if(!box) return;\n  const q = ($('search')?.value||'').trim().toLowerCase();\n  const list = store.messages(current).filter(m=>!q || m.content.toLowerCase().includes(q) || m.senderName.toLowerCase().includes(q) || (m.file && m.file.name.toLowerCase().includes(q)));\n  const nearBottom = box.scrollHeight - box.scrollTop - box.clientHeight < 80;\n  if(!list.length){ box.innerHTML = `<p class=\"empty\">${q?'No messages match your search.':'No messages yet — say hi 👋'}</p>`; return; }\n  box.innerHTML = list.map(m=>{\n    const mine = me && m.senderId===me.deviceId;\n    let file='';\n    if(m.file){ file = m.file.type.startsWith('image/') ? `<a href=\"${m.file.data}\" download=\"${esc(m.file.name)}\"><img src=\"${m.file.data}\" alt=\"${esc(m.file.name)}\"></a>` : `<a class=\"file\" href=\"${m.file.data}\" download=\"${esc(m.file.name)}\">📄 ${esc(m.file.name)} · ${fmtSize(m.file.size)}</a>`; }\n    return `<div class=\"msg ${mine?'mine':''}\"><div class=\"meta\"><strong>${esc(m.senderName)}</strong><span>${fmtTime(m.ts)}</span>${mine?`<button data-del=\"${m.id}\" aria-label=\"Delete message\">delete</button>`:''}</div>${m.content?`<div>${esc(m.content)}</div>`:''}${file}</div>`;\n  }).join('');\n  if(nearBottom || renderMessages.force){ box.scrollTop = box.scrollHeight; renderMessages.force=false; }\n}\n\nfunction renderMembers(){\n  const ul=$('memberList'); if(!ul) return;\n  const list = store.members(current).sort((a,b)=>b.lastSeen-a.lastSeen);\n  const c=$('memberCount'); if(c) c.textContent='('+list.length+')';\n  ul.innerHTML = list.map(x=>{ const on = Date.now()-x.lastSeen < 60e3; return `<li title=\"${on?'Online':'Last seen '+fmtTime(x.lastSeen)}\"><span class=\"dot ${on?'on':''}\"></span>${esc(x.name)}${me&&x.deviceId===me.deviceId?' (you)':''}</li>`; }).join('');\n}\n\nfunction renderAll(){\n  const g = store.groups().find(x=>x.id===current);\n  const t=$('roomTitle'); if(t) t.textContent = g ? '# '+g.name : 'Room';\n  const ml=$('meLabel'); if(ml) ml.textContent = me ? 'Signed in as '+me.name : '';\n  renderGroups(); renderMessages(); renderMembers();\n}\n\nfunction showJoin(){ const o=$('joinOverlay'); if(!o) return; o.hidden=false; const n=$('nickInput'); if(n){ n.value=me?me.name:''; setTimeout(()=>n.focus(),50); } }\n\n$('joinForm')?.addEventListener('submit', e=>{\n  e.preventDefault();\n  const name = ($('nickInput').value||'').trim();\n  const err=$('joinErr');\n  if(name.length<2){ if(err) err.textContent='Nickname must be at least 2 characters.'; return; }\n  me = { name, deviceId: me?.deviceId || 'd-'+uid() };\n  storage.set(K.me, me);\n  if(err) err.textContent='';\n  $('joinOverlay').hidden = true;\n  store.groups().forEach(g=>{ if(store.members(g.id).some(x=>x.deviceId===me.deviceId) || g.id===current) store.touchMember({groupId:g.id, deviceId:me.deviceId, name:me.name, lastSeen:Date.now()}); });\n  toast('Welcome, '+name+'!'); renderAll();\n});\n$('renameBtn')?.addEventListener('click', showJoin);\n\n$('groupList')?.addEventListener('click', e=>{ const b=e.target.closest('[data-gid]'); if(b){ renderMessages.force=true; selectGroup(b.dataset.gid); } });\n\n$('groupForm')?.addEventListener('submit', e=>{\n  e.preventDefault();\n  const inp=$('groupName'); const name=(inp.value||'').trim();\n  if(name.length<2){ toast('Group name needs at least 2 characters'); inp.focus(); return; }\n  if(store.groups().some(g=>g.name.toLowerCase()===name.toLowerCase())){ toast('A group with that name exists'); return; }\n  const g = store.addGroup(name); inp.value=''; selectGroup(g.id); toast('Group created');\n});\n\n$('copyLink')?.addEventListener('click', async ()=>{\n  const link = roomLink(current);\n  try { await navigator.clipboard.writeText(link); toast('Room link copied'); }\n  catch { window.prompt('Copy this room link:', link); }\n});\n\n$('search')?.addEventListener('input', renderMessages);\n\n$('fileInput')?.addEventListener('change', e=>{\n  const f = e.target.files && e.target.files[0]; const info=$('attachInfo');\n  pendingFile = null; if(info) info.textContent='';\n  if(!f) return;\n  if(f.size > 1024*1024){ toast('File too large (max 1 MB)'); e.target.value=''; return; }\n  const r = new FileReader();\n  r.onload = () => { pendingFile = {name:f.name, type:f.type||'application/octet-stream', size:f.size, data:r.result}; if(info) info.innerHTML = `📎 ${esc(f.name)} (${fmtSize(f.size)}) <button type=\"button\" class=\"ghost\" id=\"clearFile\" style=\"padding:.1rem .4rem\">remove</button>`; };\n  r.readAsDataURL(f);\n});\n$('attachInfo')?.addEventListener('click', e=>{ if(e.target.id==='clearFile'){ pendingFile=null; $('fileInput').value=''; $('attachInfo').textContent=''; } });\n\n$('composer')?.addEventListener('submit', e=>{\n  e.preventDefault();\n  if(!me){ showJoin(); return; }\n  const inp=$('msgInput'); const content=(inp.value||'').trim();\n  if(!content && !pendingFile){ inp.focus(); return; }\n  store.addMessage({id:uid(), groupId:current, senderId:me.deviceId, senderName:me.name, ts:Date.now(), content, file:pendingFile});\n  store.touchMember({groupId:current, deviceId:me.deviceId, name:me.name, lastSeen:Date.now()});\n  inp.value=''; pendingFile=null; const fi=$('fileInput'); if(fi) fi.value=''; const ai=$('attachInfo'); if(ai) ai.textContent='';\n  renderMessages.force=true; renderMessages(); renderMembers(); inp.focus();\n});\n\n$('msgs')?.addEventListener('click', e=>{\n  const b=e.target.closest('[data-del]'); if(!b) return;\n  if(confirm('Delete this message?')){ store.deleteMessage(b.dataset.del); renderMessages(); toast('Message deleted'); }\n});\n\nbc.onmessage = ev => {\n  const d = ev.data || {};\n  if(d.t==='msg') store.addMessage(d.m, true);\n  else if(d.t==='del') store.deleteMessage(d.id, true);\n  else if(d.t==='member') store.touchMember(d.rec, true);\n  else if(d.t==='group') store.addGroup(null, d.g);\n  renderAll();\n};\n\nwindow.addEventListener('hashchange', ()=>{ const g=groupFromHash(); if(g && g!==current){ renderMessages.force=true; selectGroup(g); } });\n\nsetInterval(()=>{ if(me && current) store.touchMember({groupId:current, deviceId:me.deviceId, name:me.name, lastSeen:Date.now()}); renderMembers(); }, 20000);\n\nseed();\nrenderMessages.force = true;\ncurrent = (store.groups().find(g=>g.id===groupFromHash()) || store.groups()[0]).id;\nselectGroup(current);\nif(!me) showJoin(); else toast('Welcome back, '+me.name);\n</script>\n</body>\n</html>",
