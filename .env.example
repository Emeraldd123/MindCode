# Copy to .env (gitignored) and fill in. Never commit real keys.

# OpenRouter (https://openrouter.ai/keys). Backend only.
OPENROUTER_API_KEY=
# Model slug. Team choice (Ben, 2026-11-07): Claude Opus 5.5 ($4/M in, $20/M out on OpenRouter).
OPENROUTER_MODEL=anthropic/claude-opus-5.5
# Optional attribution headers OpenRouter shows on its leaderboard
OPENROUTER_SITE_URL=https://github.com/Emeraldd123/MindCode
OPENROUTER_APP_NAME=MindCode

# Frontend calls same-origin /api (netlify dev on :8888); no API URL variable needed.

# Message board (only if the pinned board issue is not #1)
# BOARD_ISSUE=1

# 1 = use canned AI responses (no network, no key). CI and offline UI work use this.
MINDCODE_FAKE_LLM=0
