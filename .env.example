# Copy to .env (gitignored) and fill in. Never commit real keys.

# OpenRouter (https://openrouter.ai/keys). Backend only.
OPENROUTER_API_KEY=
# Default model slug, e.g. anthropic/claude-sonnet-5.5 or google/gemini-3-pro. Pick at kickoff.
OPENROUTER_MODEL=
# Optional attribution headers OpenRouter shows on its leaderboard
OPENROUTER_SITE_URL=https://github.com/Emeraldd123/MindCode
OPENROUTER_APP_NAME=MindCode

# Frontend -> backend base URL (Vite exposes VITE_* vars to the browser; never put keys here)
VITE_API_URL=http://localhost:8000

# Message board (only if the pinned board issue is not #1)
# BOARD_ISSUE=1
